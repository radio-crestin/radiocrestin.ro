    <p class="chub-macos-text">
      Dacă la deschidere macOS afișează
      <em>„church-hub.app is damaged and can't be opened”</em>, aplicația nu
      e deteriorată — e doar nesemnată încă. Rulează o singură dată comanda de
      mai jos în <strong>Terminal</strong>, apoi deschide aplicația din nou:
    </p>
    <div class="chub-macos-cmd">
      <code id="chub-macos-cmd-text">xattr -c /Applications/church-hub.app</code>
      <button class="chub-copy-btn" data-macos-copy>Copiază</button>
    </div>
    <p class="chub-macos-hint">
      Găsești Terminal cu Cmd + Space, apoi scrie „Terminal”.
    </p>
    <button class="chub-btn chub-btn-solid chub-macos-ok" data-macos-close>
      Am înțeles
    </button>
  </dialog>

  <dialog class="chub-lightbox" id="chub-lightbox">
    <button
      class="chub-lightbox-close"
      data-lightbox-close
      aria-label="Închide imaginea"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <img src="" alt="" width={1920} height={1080} />
  </dialog>
  </div>

  <script>
    // macOS download dialog: the download itself proceeds via the link's
    // default navigation; the dialog explains the one-time Gatekeeper fix.
    const macosDialog = document.getElementById(
      "chub-macos-dialog",
    ) as HTMLDialogElement | null;
    if (macosDialog) {
      document
        .querySelectorAll<HTMLAnchorElement>("a[data-macos-download]")
        .forEach((a) => {
          a.addEventListener("click", () => macosDialog.showModal());
        });
      // Deliberate close only (the X and "Am înțeles") — clicks on the
      // backdrop or inside the dialog must not dismiss the instructions.
      macosDialog.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("[data-macos-close]")) {
          macosDialog.close();
        }
      });
      const copyBtn = macosDialog.querySelector<HTMLButtonElement>("[data-macos-copy]");
      const cmdText = document.getElementById("chub-macos-cmd-text");
      copyBtn?.addEventListener("click", async () => {
        const cmd = cmdText?.textContent?.trim() ?? "";
        try {
          await navigator.clipboard.writeText(cmd);
          copyBtn.textContent = "Copiat ✓";
          setTimeout(() => (copyBtn.textContent = "Copiază"), 2000);
        } catch {
          // Clipboard unavailable — select the text so the user can copy manually.
          if (cmdText) {
            const range = document.createRange();
            range.selectNodeContents(cmdText);
            const sel = window.getSelection();
            sel?.removeAllRanges();
            sel?.addRange(range);
          }
        }
      });
    }

    // Screenshot lightbox.
    const lightbox = document.getElementById("chub-lightbox") as HTMLDialogElement | null;
    const lightboxImg = lightbox?.querySelector("img");
    if (lightbox && lightboxImg) {
      document.querySelectorAll<HTMLImageElement>("img[data-zoom]").forEach((img) => {
        img.addEventListener("click", () => {
          lightboxImg.src = img.src;
          lightboxImg.alt = img.alt;
          lightbox.showModal();
        });
      });
      lightbox.addEventListener("click", (e) => {
        // Backdrop or close button — clicks on the image stay open.
        if (e.target === lightbox || (e.target as HTMLElement).closest("[data-lightbox-close]")) {
          lightbox.close();
        }
      });
    }
  </script>
