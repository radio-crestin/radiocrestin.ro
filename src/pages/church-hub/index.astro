---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FooterLinks from "@/components/FooterLinks";
import { SITE_URL } from "@/constants/constants";
import { SEO_CHURCH_HUB } from "@/utils/seo";

const GITHUB_REPO = "https://github.com/radio-crestin/church-hub";
const RELEASES_URL = `${GITHUB_REPO}/releases/latest`;
const ALL_RELEASES_URL = `${GITHUB_REPO}/releases`;

// Release assets carry the version in the filename, so the stable
// `releases/latest/download/<name>` URLs do not exist — resolve the real
// asset URLs at build time, with a verified pinned release as fallback.
const FALLBACK_DOWNLOADS = {
  version: "0.1.82",
  windows: `${GITHUB_REPO}/releases/download/v0.1.82/church-hub-windows-x64-v-0.1.82.exe`,
  macArm: `${GITHUB_REPO}/releases/download/v0.1.82/church-hub-macos-arm64-v-0.1.82.dmg`,
  macIntel: `${GITHUB_REPO}/releases/download/v0.1.82/church-hub-macos-x64-v-0.1.82.dmg`,
};

let downloads = FALLBACK_DOWNLOADS;
try {
  const res = await fetch(
    "https://api.github.com/repos/radio-crestin/church-hub/releases/latest",
    {
      headers: { Accept: "application/vnd.github+json" },
      signal: AbortSignal.timeout(8000),
    },
  );
  if (res.ok) {
    const release = await res.json();
    const assets: { name: string; browser_download_url: string }[] =
      release.assets ?? [];
    const asset = (re: RegExp) =>
      assets.find((a) => re.test(a.name))?.browser_download_url;
    const windows = asset(/^church-hub-windows-x64-v-[\d.]+\.exe$/);
    const macArm = asset(/^church-hub-macos-arm64-v-[\d.]+\.dmg$/);
    const macIntel = asset(/^church-hub-macos-x64-v-[\d.]+\.dmg$/);
    if (windows && macArm && macIntel) {
      downloads = {
        version:
          String(release.tag_name ?? "").replace(/^v/, "") ||
          FALLBACK_DOWNLOADS.version,
        windows,
        macArm,
        macIntel,
      };
    }
  }
} catch {
  // GitHub API unavailable at build time — the pinned release keeps the buttons working.
}

const features = [
  {
    title: "Camera de control",
    alt: "Church Hub – Camera de control cu previzualizare live și coada de prezentare",
    image: "/images/church-hub/control-room.png",
    items: [
      "Previzualizare live — vezi exact ce apare pe ecran înainte să afișezi",
      "Coadă de prezentare cu drag & drop pentru reordonare",
      "Navigare din tastatură pentru control rapid al slide-urilor",
      "Multi-ecran: principal, scenă, livestream și kiosk",
    ],
  },
  {
    title: "Bibliotecă de cântări",
    alt: "Church Hub – biblioteca cu peste 40.000 de cântări cu căutare instant",
    image: "/images/church-hub/songs-list.png",
    items: [
      "Peste 40.000 de cântări incluse, gata de proiectat",
      "Căutare instant în versuri și titluri",
      "Import inteligent din OpenSong și PowerPoint, cu detectarea duplicatelor",
      "Suport CCLI pentru evidența licențelor și copyright",
    ],
  },
  {
    title: "Modul biblic",
    alt: "Church Hub – afișarea versetelor biblice pe ecran în timpul predicii",
    image: "/images/church-hub/bible.png",
    items: [
      "Căutare după referință sau cuvinte-cheie",
      "Mai multe traduceri ale Bibliei, în paralel",
      "Navigare rapidă prin toate cărțile",
      "Previzualizare înainte de afișarea pe ecran",
    ],
  },
  {
    title: "Integrare livestream",
    alt: "Church Hub – integrare livestream cu OBS Studio și YouTube",
    image: "/images/church-hub/livestream.png",
    items: [
      "Lansare broadcast YouTube cu un singur click",
      "Comutare scene OBS Studio direct din aplicație",
      "Mixer audio cu 16+ canale",
      "Comutare automată a scenelor în funcție de conținut",
    ],
  },
  {
    title: "Programe de servicii",
    alt: "Church Hub – constructor de programe pentru serviciile bisericii",
    image: "/images/church-hub/schedules.png",
    items: [
      "Construiește programul serviciului: cântări, versete, slide-uri",
      "Reordonare intuitivă cu drag & drop",
      "Import și export de programe pentru partajare între echipe",
      "Totul pregătit înainte de începerea serviciului",
    ],
  },
  {
    title: "Editor de ecran",
    alt: "Church Hub – editor vizual WYSIWYG pentru aspectul textului proiectat",
    image: "/images/church-hub/screen-editor.png",
    items: [
      "Editor vizual WYSIWYG cu drag & resize",
      "Stilizare text: font, dimensiune, culoare, animații",
      "Auto-scalare a textului pentru încadrare perfectă",
      "OBS Browser Source pentru subtitrări live peste transmisiune",
    ],
  },
  {
    title: "Player de muzică",
    alt: "Church Hub – player de muzică de fundal pentru servicii",
    image: "/images/church-hub/music.png",
    items: [
      "Muzică de fundal înainte și după program",
      "Organizare pe foldere și playlisturi",
      "Mod shuffle pentru redare aleatorie",
      "Volum controlat independent de prezentare",
    ],
  },
  {
    title: "Tonalitățile cântărilor",
    alt: "Church Hub – istoricul cântărilor prezentate cu tonalitățile lor",
    image: "/images/church-hub/song-key.png",
    items: [
      "Istoricul cântărilor prezentate, cu tonalitățile muzicale",
      "Statistici de utilizare pentru fiecare cântare",
      "Cronologie organizată pe zile",
      "Referință rapidă pentru instrumentiști și închinători",
    ],
  },
];

const faqs = [
  {
    question:
      "Ce program pot folosi pentru a proiecta versurile cântărilor la biserică?",
    answer: `<p>Church Hub este un program gratuit de proiecție pentru biserici, disponibil pe Windows și macOS. Vine cu o bibliotecă de peste 40.000 de cântări gata de proiectat, afișează versete biblice și rulează pe oricâte ecrane ai nevoie: videoproiector, ecran de scenă pentru închinători și ieșire dedicată pentru livestream.</p>`,
  },
  {
    question: "Church Hub este cu adevărat gratuit?",
    answer: `<p>Da. Church Hub este open-source și complet gratuit — fără abonament, fără licențe per calculator și fără funcții blocate. Este dezvoltat de echipa <a href="/">Radio Creștin</a> ca dar pentru bisericile din România și diaspora, iar codul sursă este public pe <a href="${GITHUB_REPO}" target="_blank" rel="noopener noreferrer">GitHub</a>.</p>`,
  },
  {
    question:
      "Este Church Hub o alternativă la EasyWorship, ProPresenter sau OpenLP?",
    answer: `<p>Da. Church Hub acoperă funcțiile principale ale acestor programe — proiecție de cântări și versete, programe de servicii, multi-ecran — și adaugă biblioteca românească de cântări, interfața în limba română și integrarea directă cu OBS Studio și YouTube. Importul din OpenSong și PowerPoint face trecerea ușoară, iar spre deosebire de EasyWorship sau ProPresenter, nu plătești nimic.</p>`,
  },
  {
    question: "Pe ce sisteme funcționează Church Hub?",
    answer: `<p>Church Hub rulează nativ pe Windows 10/11 (x64) și pe macOS — atât pe Mac-urile cu Apple Silicon (M1–M4), cât și pe cele cu procesor Intel. Suportă mai multe ecrane simultan: ecranul principal de proiecție, ecranul de scenă, ieșirea pentru livestream și modul kiosk.</p>`,
  },
  {
    question: "Pot afișa versete biblice în română în timpul predicii?",
    answer: `<p>Da. Modulul biblic include mai multe traduceri ale Bibliei și îți permite să cauți după referință (de ex. „Ioan 3:16”) sau după cuvinte-cheie, să previzualizezi textul și să îl afișezi instant pe ecran în timpul predicii.</p>`,
  },
  {
    question: "Cum transmit serviciul bisericii live pe YouTube?",
    answer: `<p>Church Hub se integrează cu OBS Studio: lansezi broadcastul de YouTube cu un singur click, comuți scenele OBS direct din aplicație și controlezi sunetul din mixerul audio cu 16+ canale. Versurile pot fi suprapuse peste transmisiune ca subtitrări, prin OBS Browser Source.</p>`,
  },
  {
    question:
      "Ce fac dacă pe macOS apare mesajul „church-hub.app is damaged”?",
    answer: `<p>Mesajul apare pentru că aplicația nu este încă semnată cu certificat Apple, nu pentru că ar fi deteriorată. Deschide Terminal și rulează comanda: <code>xattr -c /Applications/church-hub.app</code> — apoi pornește aplicația normal.</p>`,
  },
];

const screenshotUrls = features.map((f) => `${SITE_URL}${f.image}`);

const appSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Church Hub",
  operatingSystem: "Windows 10/11, macOS",
  applicationCategory: "MultimediaApplication",
  description: SEO_CHURCH_HUB.description,
  url: SEO_CHURCH_HUB.fullURL,
  image: SEO_CHURCH_HUB.imageUrl,
  screenshot: screenshotUrls,
  softwareVersion: downloads.version,
  downloadUrl: RELEASES_URL,
  isAccessibleForFree: true,
  inLanguage: "ro",
  featureList: [
    "Proiecție versuri cântări (bibliotecă cu 40.000+ cântări incluse)",
    "Afișare versete biblice cu mai multe traduceri",
    "Prezentare multi-ecran: principal, scenă, livestream, kiosk",
    "Integrare OBS Studio și lansare broadcast YouTube",
    "Programe de servicii cu drag & drop",
    "Editor vizual de ecran (WYSIWYG)",
    "Player de muzică de fundal",
    "Evidența tonalităților cântărilor și suport CCLI",
  ],
  author: { "@id": `${SITE_URL}/#organization` },
  publisher: { "@id": `${SITE_URL}/#organization` },
  offers: { "@type": "Offer", price: "0", priceCurrency: "RON" },
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Radio Creștin", item: `${SITE_URL}/` },
    { "@type": "ListItem", position: 2, name: "Church Hub", item: SEO_CHURCH_HUB.fullURL },
  ],
});
---

<BaseLayout {...SEO_CHURCH_HUB} twitterCard="summary_large_image">
  <script type="application/ld+json" set:html={appSchema} slot="head" />
  <script type="application/ld+json" set:html={faqSchema} slot="head" />
  <script type="application/ld+json" set:html={breadcrumbSchema} slot="head" />
  <link
    rel="preload"
    as="image"
    href="/images/church-hub/songs-view.png"
    fetchpriority="high"
    slot="head"
  />

  <div class="chub-page">
    <header class="chub-hero">
      <nav class="chub-nav">
        <a href="/church-hub/" class="chub-logo">
          <img
            src="/images/church-hub/icon.png"
            alt=""
            width={28}
            height={28}
          />
          <span>Church Hub</span>
        </a>
        <a
          href={GITHUB_REPO}
          target="_blank"
          rel="noopener noreferrer"
          class="chub-nav-github"
        >
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
            <span>GitHub</span>
        </a>
      </nav>

      <div class="chub-hero-grid">
        <div class="chub-hero-text">
        <h1>
          Program gratuit de proiecție cântări și Biblie pentru biserică
        </h1>
        <p class="chub-lead">
          Proiectezi versurile cântărilor și versete din Biblie, pregătești
          programul serviciului și transmiți live pe YouTube — totul
          într-o singură aplicație, cu peste 40.000 de cântări incluse.
        </p>

        <div class="chub-downloads">
          <a
            href={downloads.windows}
            class="chub-btn chub-btn-solid"
            data-os="windows"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M3 5.5L10.5 4.4V11.5H3V5.5ZM3 18.5L10.5 19.6V12.5H3V18.5ZM11.5 19.75L21 21V12.5H11.5V19.75ZM11.5 4.25V11.5H21V3L11.5 4.25Z"
              ></path>
            </svg>
            Descarcă pentru Windows
          </a>
          <a
            href={downloads.macArm}
            class="chub-btn chub-btn-outline"
            data-os="mac"
            data-macos-download
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M17.05 12.54c-.03-2.6 2.12-3.85 2.22-3.91-1.21-1.77-3.09-2.01-3.76-2.04-1.6-.16-3.12.94-3.93.94-.81 0-2.06-.92-3.39-.89-1.74.03-3.35 1.01-4.24 2.57-1.81 3.14-.46 7.78 1.3 10.33.86 1.25 1.89 2.65 3.24 2.6 1.3-.05 1.79-.84 3.36-.84 1.57 0 2.01.84 3.38.81 1.4-.02 2.28-1.27 3.14-2.53.99-1.45 1.39-2.85 1.41-2.92-.03-.01-2.71-1.04-2.73-4.12zM14.46 4.9c.72-.87 1.2-2.08 1.07-3.29-1.03.04-2.29.69-3.03 1.56-.66.77-1.25 2-1.09 3.18 1.15.09 2.33-.58 3.05-1.45z"
              ></path>
            </svg>
            Descarcă pentru macOS
          </a>
        </div>
        <script is:inline>
          // Parser-blocking on purpose: highlights and puts first the
          // visitor's platform before first paint, so nothing "jumps".
          (function () {
            var ua = navigator.platform || navigator.userAgent;
            if (!/Mac|iPhone|iPad/i.test(ua)) return;
            var wrap = document.querySelector(".chub-downloads");
            if (!wrap) return;
            var btns = wrap.querySelectorAll(".chub-btn");
            for (var i = 0; i < btns.length; i++) {
              var solid = btns[i].getAttribute("data-os") === "mac";
              btns[i].classList.toggle("chub-btn-solid", solid);
              btns[i].classList.toggle("chub-btn-outline", !solid);
            }
            var mac = wrap.querySelector('[data-os="mac"]');
            if (mac) wrap.insertBefore(mac, wrap.firstChild);
          })();
        </script>
        <p class="chub-download-meta">
          <span>Versiunea {downloads.version}</span>
          <span aria-hidden="true">·</span>
          <a href={downloads.macIntel} data-macos-download>
            Mac cu procesor Intel?
          </a>
          <span aria-hidden="true">·</span>
          <a href={ALL_RELEASES_URL} target="_blank" rel="noopener noreferrer">
            Toate versiunile pe GitHub
          </a>
        </p>
        </div>

        <div class="chub-hero-visual">
          <div class="chub-window">
            <div class="chub-window-bar" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
            <img
              src="/images/church-hub/songs-view.png"
              alt="Church Hub – vizualizarea unei cântări: strofele în stânga, previzualizarea live a versurilor proiectate în dreapta"
              width={1920}
              height={1080}
              fetchpriority="high"
              data-zoom
            />
          </div>
        </div>
      </div>
    </header>

    <section class="chub-stats-strip" aria-label="Church Hub pe scurt">
      <ul class="chub-stats">
        <li>
          <strong>40.000+</strong>
          <span>cântări incluse</span>
        </li>
        <li>
          <strong>4 ecrane</strong>
          <span>principal, scenă, livestream, kiosk</span>
        </li>
        <li>
          <strong>1 click</strong>
          <span>până ești live pe YouTube</span>
        </li>
        <li>
          <strong>0 lei</strong>
          <span>gratuit &amp; open-source</span>
        </li>
      </ul>
    </section>

    <section class="chub-features">
      <div class="chub-inner">
        <h2>Tot ce ai nevoie pentru serviciul de închinare</h2>
        <p class="chub-section-lead">
          De la prima cântare până la finalul transmisiunii live — fiecare
          modul este gândit pentru echipa tehnică a bisericii.
        </p>

        {
          features.map((feature) => (
            <article class="chub-feature">
              <div class="chub-feature-media">
                <img
                  src={feature.image}
                  alt={feature.alt}
                  width={1920}
                  height={1080}
                  loading="lazy"
                  data-zoom
                />
              </div>
              <div class="chub-feature-copy">
                <h3>{feature.title}</h3>
                <ul>
                  {feature.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="chub-compare">
      <div class="chub-inner">
        <h2>Alternativă gratuită la EasyWorship și ProPresenter</h2>
        <p class="chub-section-lead">
          Church Hub oferă funcțiile pentru care alte programe de prezentare
          cer abonament sau licență — gratuit, în limba română. Iar dacă vii
          de la OpenLP sau VideoPsalm, vei regăsi tot ce știi, plus biblioteca
          de cântări și integrarea livestream.
        </p>
        <div class="chub-table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col"></th>
                <th scope="col" class="chub-col-hub">Church Hub</th>
                <th scope="col">EasyWorship</th>
                <th scope="col">ProPresenter</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Preț</th>
                <td class="chub-col-hub">Gratuit, fără abonament</td>
                <td>Abonament plătit</td>
                <td>Licență plătită</td>
              </tr>
              <tr>
                <th scope="row">Open source</th>
                <td class="chub-col-hub"><span class="chub-yes">✓</span></td>
                <td><span class="chub-no">✗</span></td>
                <td><span class="chub-no">✗</span></td>
              </tr>
              <tr>
                <th scope="row">Interfață în limba română</th>
                <td class="chub-col-hub"><span class="chub-yes">✓</span></td>
                <td><span class="chub-no">✗</span></td>
                <td><span class="chub-no">✗</span></td>
              </tr>
              <tr>
                <th scope="row">40.000+ cântări incluse</th>
                <td class="chub-col-hub"><span class="chub-yes">✓</span></td>
                <td><span class="chub-no">✗</span></td>
                <td><span class="chub-no">✗</span></td>
              </tr>
              <tr>
                <th scope="row">Versete biblice pe ecran</th>
                <td class="chub-col-hub"><span class="chub-yes">✓</span></td>
                <td><span class="chub-yes">✓</span></td>
                <td><span class="chub-yes">✓</span></td>
              </tr>
              <tr>
                <th scope="row">Control OBS + lansare YouTube integrate</th>
                <td class="chub-col-hub"><span class="chub-yes">✓</span></td>
                <td><span class="chub-no">✗</span></td>
                <td><span class="chub-no">✗</span></td>
              </tr>
              <tr>
                <th scope="row">Prezentare multi-ecran</th>
                <td class="chub-col-hub"><span class="chub-yes">✓</span></td>
                <td><span class="chub-yes">✓</span></td>
                <td><span class="chub-yes">✓</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="chub-steps">
      <div class="chub-inner">
        <h2>Gata de folosit în 3 pași</h2>
        <div class="chub-steps-grid">
          <div class="chub-step">
            <span class="chub-step-num">1</span>
            <h3>Descarcă și instalează</h3>
            <p>
              Instalează Church Hub pe Windows sau macOS. Fără cont, fără
              activare — aplicația e gata în câteva minute.
            </p>
          </div>
          <div class="chub-step">
            <span class="chub-step-num">2</span>
            <h3>Deschide biblioteca de cântări</h3>
            <p>
              Peste 40.000 de cântări sunt deja incluse. Adaugi și colecția
              bisericii tale prin import din OpenSong sau PowerPoint.
            </p>
          </div>
          <div class="chub-step">
            <span class="chub-step-num">3</span>
            <h3>Conectează ecranele și prezintă</h3>
            <p>
              Videoproiector, ecran de scenă, livestream — controlezi totul
              din Camera de control, cu previzualizare live.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="chub-faq-section">
      <div class="chub-inner">
        <div class="chub-faq">
          <h2 class="chub-faq-heading">Întrebări frecvente</h2>
          <div class="chub-faq-list">
            {
              faqs.map((faq) => (
                <details class="chub-faq-item">
                  <summary>
                    <h3>{faq.question}</h3>
                    <svg
                      class="chub-faq-chevron"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M6 9l6 6 6-6" />
                    </svg>
                  </summary>
                  <div class="chub-faq-body" set:html={faq.answer} />
