# Default for everything (HTML pages) — never cache; security headers site-wide.
# NOTE: matching is cumulative — a request matching several rules inherits ALL their
# headers, and duplicates get comma-joined. Specific rules below therefore detach
# the inherited Cache-Control (`! Cache-Control`) before setting their own.
/*
  Cache-Control: public, max-age=0, must-revalidate
  # Pages sent this on every asset; other origins (the cast receiver, share pages) load ours.
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Hashed static assets — immutable, cache forever (content-hash in filename)
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Fonts — cache for 1 year
/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Images — cache for 1 week
/images/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

/icons/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

# Station thumbnails — slug-named but regenerated each build (no content hash),
# so 1 day fresh + a week of background revalidation instead of immutable
/station-thumbnails/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Text files with Romanian diacritics: declare UTF-8 (Workers assets send bare text/plain).
/llms.txt
  Content-Type: text/plain; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8
