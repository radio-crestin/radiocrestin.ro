---
// A story's share page: what a shared story link opens on a phone without the app, and the
// preview (title, picture) chat apps show. The app opens these links itself when installed.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { SITE_URL, getAndroidStoreLink, getIOSStoreLink } from "@/constants/constants";
import { DEFAULT_SHARE_IMAGE } from "@/utils/seo";
import { getStoriesForBuild, storyImage } from "@/services/storiesBuild";
import type { IStory } from "@/models/Story";

export async function getStaticPaths() {
  const stories = await getStoriesForBuild();
  return stories.map((story) => ({ params: { slug: story.slug }, props: { story } }));
}

const { story } = Astro.props as { story: IStory };
const image = storyImage(story);
const meta = {
  title: `${story.title} | Radio Creștin`,
  description: `${story.title}: o poveste Radio Creștin. Deschide-o în aplicația Radio Creștin.`,
  imageUrl: image ?? DEFAULT_SHARE_IMAGE,
  fullURL: `${SITE_URL}/poveste/${story.slug}/`,
};
---

<BaseLayout {...meta} noindex twitterCard={image ? "summary_large_image" : "summary"}>
  <main class="story-share">
    <a class="story-share__card" href={`/poveste/${story.slug}/`}>
      {image && <img src={image} alt="" width="360" height="640" />}
      <span class="story-share__title">{story.title}</span>
    </a>
    <p class="story-share__text">Povestea se deschide în aplicația Radio Creștin.</p>
    <div class="story-share__stores">
      <a class="story-share__button" href={getAndroidStoreLink("story")}>Google Play</a>
      <a class="story-share__button" href={getIOSStoreLink("story")}>App Store</a>
    </div>
    <a class="story-share__home" href="/">Ascultă radio pe radiocrestin.ro</a>
  </main>
</BaseLayout>

<style>
  .story-share {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 32px 16px 48px;
    text-align: center;
  }
  .story-share__card {
    position: relative;
    display: block;
    width: min(360px, 100%);
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: 20px;
    background: #111;
    color: #fff;
    text-decoration: none;
  }
  .story-share__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .story-share__title {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    font-size: 20px;
    font-weight: 700;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
  }
  .story-share__text {
    margin: 0;
    font-size: 16px;
  }
  .story-share__stores {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .story-share__button {
    padding: 12px 20px;
    border-radius: 999px;
    background: #2196f3;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
  .story-share__home {
    font-size: 14px;
  }
</style>
