---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContactForm from "@/components/Contact/ContactForm";
import { getStationOptions } from "@/services/getStationOptions";
import { SEO_CONTACT } from "@/utils/seo";

const stations = await getStationOptions();
---

<BaseLayout {...SEO_CONTACT.announcement}>
  <ContactForm client:load kind="announcement" stations={stations} />
</BaseLayout>
